# Node Environment
NODE_ENV=production
PORT=3001

# Neon PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Frontend URL (Netlify deployed site)
FRONTEND_URL=https://spotify-music-quiz.netlify.app

# Better Auth Configuration
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here
BETTER_AUTH_URL=https://spotify-music-quiz.netlify.app/api/auth

# Spotify API Credentials (from Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google AI / OAuth Credentials (for Gemini BYOK Account Linking)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

GEMINI_API_KEY=YOUR_GEMINI_API_KEY