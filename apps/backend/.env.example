# Node Environment (development | production)
NODE_ENV=production
PORT=3001

# PostgreSQL Database URL
DATABASE_URL=postgresql://user:password@ep-sample-123456.eu-central-1.aws.neon.tech/neondb?sslmode=require

# Frontend URL (Required in production - Netlify deployed site)
# In development, leave blank or omit to dynamically support localhost, 10.0.0.x, and LAN IPs.
FRONTEND_URL=https://spotify-music-quiz.netlify.app

# Better Auth Secret (Optional, generates session encryption)
BETTER_AUTH_SECRET=generate_a_random_32_character_secret_here

# Spotify API Credentials (from Spotify Developer Dashboard)
SPOTIFY_CLIENT_ID=your_spotify_client_id
SPOTIFY_CLIENT_SECRET=your_spotify_client_secret

# Google AI / OAuth Credentials (for Gemini BYOK Account Linking - Optional)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Server-side Gemini API Key (Optional)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY